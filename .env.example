# 可选：接入真实文本模型（OpenAI 兼容：智谱 GLM / DeepSeek / Qwen 均可）
# 设置后服务端默认用真实厂商生成（mode=platform）；未设置则回落到 Mock 样本（mode=mock，无需密钥）。
# 运行期也可在 Web「设置 → 模型配置」里选择厂商预设或填自定义 API；保存后会写入被 Git 忽略、仅当前用户可读写的 .data/model-config.json。
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# 可选：预设里 GLM 默认模型（不填用 glm-4-flash）。
GLM_MODEL=

# 可选：M1 最小持久化。设置后简历/面试/转写/评价按 JSON 文件落盘（重启不丢）；
# 未设置则纯内存（进程内，重启清空）。提示词模板始终在启动时重新种子化。
DATA_FILE=.data/store.json
