{
  "name": "ai_interviewer",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "smoke": "pnpm -r run typecheck && pnpm -r run test && pnpm --filter @ai-interviewer/web run build",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "schemas": "pnpm --filter @ai-interviewer/contracts run schemas"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~5.7.2"
  }
}