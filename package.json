{
  "name": "ai_interviewer",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "smoke": "pnpm schemas:check && pnpm -r run typecheck && pnpm -r run test && pnpm --filter @ai-interviewer/web run build",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "schemas": "pnpm --filter @ai-interviewer/contracts run schemas",
    "schemas:check": "pnpm schemas && git diff --exit-code -- packages/contracts/schemas"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
