{
  "$ref": "#/definitions/P01Output",
  "definitions": {
    "P01Output": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidateName": {
          "type": "string",
          "maxLength": 50
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "school": {
                "type": "string"
              },
              "degree": {
                "type": "string"
              },
              "major": {
                "type": "string"
              },
              "period": {
                "type": "string"
              }
            },
            "required": [
              "school",
              "degree",
              "major",
              "period"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "experiences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "company": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              }
            },
            "required": [
              "company",
              "role",
              "period",
              "bullets"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "stack": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 20
              }
            },
            "required": [
              "name",
              "role",
              "stack",
              "points"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "level": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "maxItems": 30
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "field",
              "note"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "summary",
        "education",
        "skills",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
