{
  "$ref": "#/definitions/P05Output",
  "definitions": {
    "P05Output": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "add",
                  "modify",
                  "remove",
                  "reorder"
                ]
              },
              "ref": {
                "type": "string"
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "after"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "newlyNoted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {
                "type": "string"
              },
              "appliedTo": {
                "type": "string",
                "enum": [
                  "intro",
                  "tech",
                  "biz",
                  "hr"
                ]
              }
            },
            "required": [
              "fact",
              "appliedTo"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "tech",
                  "biz",
                  "hr"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "reason": {
                "type": "string",
                "maxLength": 120
              },
              "kind": {
                "type": "string",
                "enum": [
                  "keypoint",
                  "deepen",
                  "contradiction"
                ]
              }
            },
            "required": [
              "phase",
              "question"
            ],
            "additionalProperties": false
          },
          "maxItems": 6
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "needsConfirm"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "mode",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
