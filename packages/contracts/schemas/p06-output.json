{
  "$ref": "#/definitions/P06Output",
  "definitions": {
    "P06Output": {
      "type": "object",
      "properties": {
        "questionText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "begin",
            "mid",
            "deep"
          ]
        },
        "targetAspect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "probePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "purpose"
            ],
            "additionalProperties": false
          },
          "maxItems": 4
        },
        "biasToDirections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "contextUsed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 10
        },
        "avoidDuplicatesWith": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "questionText",
        "topic",
        "difficulty",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
